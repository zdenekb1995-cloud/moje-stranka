<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>4U Centre Apartments | Check-in hosta</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #f4f0eb;
            font-family: 'Segoe UI', Roboto, sans-serif;
            padding: 2rem 1rem;
        }
        .container {
            max-width: 800px;
            margin: 0 auto;
        }
        .hero {
            text-align: center;
            margin-bottom: 2rem;
        }
        .hero h1 {
            font-size: 2.5rem;
            color: #1e3c3f;
            letter-spacing: 1px;
        }
        .hero p {
            color: #a07e5c;
            font-size: 1rem;
        }
        .form-card {
            background: white;
            border-radius: 32px;
            padding: 2rem;
            box-shadow: 0 12px 28px rgba(0,0,0,0.05);
            border: 1px solid #e9e2d9;
        }
        .form-row {
            margin-bottom: 1.5rem;
        }
        label {
            font-weight: 600;
            display: block;
            margin-bottom: 0.5rem;
            color: #2c3a2f;
        }
        input, select {
            width: 100%;
            padding: 0.9rem 1rem;
            border: 1px solid #ddd2c5;
            border-radius: 24px;
            font-size: 1rem;
            background: #fefcf9;
        }
        input:focus, select:focus {
            outline: none;
            border-color: #a07e5c;
            box-shadow: 0 0 0 3px rgba(160,126,92,0.1);
        }
        .double-group {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .double-group > div {
            flex: 1;
        }
        .btn-submit {
            background: #1e3c3f;
            color: white;
            border: none;
            padding: 1rem;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 40px;
            width: 100%;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn-submit:hover {
            background: #0f2a2c;
        }
        .gdpr-note {
            font-size: 0.75rem;
            background: #f4efea;
            padding: 1rem;
            border-radius: 20px;
            margin: 1.5rem 0 1rem;
            text-align: center;
            color: #4e5c54;
        }
        .status {
            margin-top: 1rem;
            text-align: center;
            font-weight: 500;
            padding: 0.5rem;
            border-radius: 40px;
        }
        footer {
            text-align: center;
            font-size: 0.7rem;
            color: #8f8b84;
            margin-top: 2rem;
        }
        .required-star {
            color: #b1624b;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="hero">
        <h1>4U Centre APARTMENTS</h1>
        <p>Olomouc — Váš domov v srdci města</p>
        <p style="font-size: 0.9rem; margin-top: 0.5rem;">✨ Plně vybavené apartmány 1+kk | Wi-Fi | TV | Kuchyň</p>
    </div>

    <div class="form-card">
        <h2 style="margin-bottom: 0.5rem;">✅ Povinný check‑in formulář</h2>
        <p style="margin-bottom: 1.5rem; color: #5b5a56;">Podle zákona č. 326/1999 Sb. jsme povinni evidovat totožnost hosta.</p>
        
        <!-- ===== ZDE VLOŽTE SVOJI FORMSPREE URL ===== -->
        <form action="https://formspree.io/f/VAŠE_ENDPOINT_ID" method="POST" enctype="multipart/form-data" id="checkinForm">
        <!-- ========================================= -->
            
            <!-- Hidden pole pro předmět e-mailu (volitelné) -->
            <input type="hidden" name="_subject" value="Nový check-in hosta - 4U Centre">
            
            <!-- Anti-spam (automaticky přidá honeypot, ale můžeme nechat) -->
            
            <div class="form-row">
                <label>Jméno a příjmení <span class="required-star">*</span></label>
                <input type="text" name="jmeno" id="fullname" required placeholder="např. Jana Nováková">
            </div>
            
            <div class="double-group">
                <div>
                    <label>Datum narození <span class="required-star">*</span></label>
                    <input type="date" name="datum_narozeni" id="birthdate" required>
                </div>
                <div>
                    <label>Číslo OP / pasu <span class="required-star">*</span></label>
                    <input type="text" name="cislo_op" id="idNumber" required placeholder="CZ1234567">
                </div>
            </div>
            
            <div class="double-group">
                <div>
                    <label>E-mail <span class="required-star">*</span></label>
                    <input type="email" name="email" id="email" required placeholder="host@email.cz">
                </div>
                <div>
                    <label>Telefon <span class="required-star">*</span></label>
                    <input type="tel" name="telefon" id="phone" required placeholder="+420 777 123 456">
                </div>
            </div>
            
            <div class="form-row">
                <label>Vyberte apartmán <span class="required-star">*</span></label>
                <select name="apartman" id="apartment" required>
                    <option value="">-- vyberte --</option>
                    <option value="Apartmán 1+kk - č.4 (jižní)">Apartmán č.4 (jižní)</option>
                    <option value="Apartmán 1+kk - č.4B (severní)">Apartmán č.4B (severní)</option>
                </select>
            </div>
            
            <div class="form-row">
                <label>📸 Fotografie občanského průkazu (přední strana) <span class="required-star">*</span></label>
                <input type="file" name="fotografie_op" id="photoInput" accept="image/jpeg,image/png,image/jpg" required>
                <small style="color: #7a6e60; display: block; margin-top: 0.3rem;">Vyfoťte nebo nahrajte snímek OP (max. 10 MB)</small>
            </div>
            
            <div class="gdpr-note">
                ⚖️ <strong>GDPR & ochrana osobních údajů</strong><br>
                Vaše údaje jsou zpracovávány výhradně za účelem splnění zákonné povinnosti ubytovatele (evidence hostů). 
                Fotografie dokladu je bezpečně uložena a po skončení pobytu vymazána. Odesláním souhlasíte s podmínkami.
            </div>
            
            <button type="submit" class="btn-submit">🏨 ODESLAT CHECK-IN</button>
            <div id="formStatus" class="status"></div>
        </form>
    </div>
    <footer>
        © 4U Centre Apartments Olomouc | kontakt: info@4uolomouc.cz
    </footer>
</div>

<script>
    const form = document.getElementById('checkinForm');
    const statusDiv = document.getElementById('formStatus');
    
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Kontrola, zda je nahraná fotka
        const photoFile = document.getElementById('photoInput').files[0];
        if (!photoFile) {
            statusDiv.innerHTML = '❌ Nahrajte prosím fotografii občanského průkazu.';
            statusDiv.style.color = '#b1624b';
            statusDiv.style.background = '#fef0ed';
            return;
        }
        
        // Kontrola velikosti (Formspree má limit 10MB)
        if (photoFile.size > 10 * 1024 * 1024) {
            statusDiv.innerHTML = '❌ Fotografie je příliš velká (max. 10 MB).';
            statusDiv.style.color = '#b1624b';
            statusDiv.style.background = '#fef0ed';
            return;
        }
        
        statusDiv.innerHTML = '⏳ Odesílám údaje...';
        statusDiv.style.color = '#a07e5c';
        statusDiv.style.background = '#fef8f0';
        
        try {
            // Formspree zpracuje normální POST včetně souboru
            const formData = new FormData(form);
            
            const response = await fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: {
                    'Accept': 'application/json'
                }
            });
            
            if (response.ok) {
                statusDiv.innerHTML = '✅ Check-in úspěšně dokončen! Děkujeme. Potvrzení přijde na e-mail.';
                statusDiv.style.color = '#2c6e5c';
                statusDiv.style.background = '#e6f4ef';
                form.reset();
                
                // Smazat status po 5 sekundách
                setTimeout(() => {
                    statusDiv.innerHTML = '';
                    statusDiv.style.background = 'transparent';
                }, 5000);
            } else {
                const errorData = await response.json();
                console.error(errorData);
                throw new Error('Chyba odeslání');
            }
        } catch (error) {
            statusDiv.innerHTML = '❌ Chyba při odesílání. Zkuste to prosím znovu nebo kontaktujte recepci.';
            statusDiv.style.color = '#b1624b';
            statusDiv.style.background = '#fef0ed';
            console.error(error);
        }
    });
</script>
</body>
</html>
